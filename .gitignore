node_modules/
.env
.env.*
.env-*
*.env.local
*.env.backup*
*credentials*.json
rc-credentials*.json
!.env.example
!apps/**/.env.example
.ssh/
*.pem
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
coverage/
runtime/

# Local diagnostic bundles. Commit sanitized summaries in docs/ instead.
out/rcx-manual-test-report-*.log
out/rcx-manual-dial-ticket-summary-*.md

# Telephony recordings — local cache only. Drive is canonical.
# Never commit raw call audio; we had 91 MP3s (~614 MB) leak via ops/
# before this rule existed. git-filter-repo will scrub history; these
# patterns keep new ones from sneaking back in.
*.mp3
*.wav
*.opus
*.m4a
*.aac
*.flac
ops/end-of-day-recordings/
ops/manual-recording-dumps/
runtime/audio/
runtime/recordings/
# Sidecar JSON manifests live next to the recordings — also local-only.
ops/end-of-day-recordings/**/*.json
ops/manual-recording-dumps/**/*.json
ops/scheduled-logs/*.log

# Local Drop.co fire-test harnesses. Production voicemail drop uses the RingCX
# barge path; keep campaign one-offs out of patches and GitHub.
scripts/drop-phonefrom-local-server.js

# runtime logs (untracked 2026-07-08 review note: local-web-current.err.log alone carried 521k stale lines)
logs/
tmp-alpha-audit-tests.*

# Local data artifacts — never commit (PII / large / generated)
exports/
live-captures/
outputs/

# Generated report output — customer phone numbers and CallRail recording
# links with live access keys. Never commit these. Root-anchored: an
# unanchored "reports/" also swallows packages/shared-templates/src/templates/reports.
/reports/
tmp/
# Logics activity dumps carry ClientName and emails — never commit them.
tests/fixtures/activities-*.json
*.orig

# Analysis DATA artifacts: case ids, client names, assignees, notes. The
# scripts that produce and consume them are code and stay tracked; their
# OUTPUT is customer data and must never be committed. (Audit 2026-08-06, P0.)
scripts/analysis/*.json
scripts/analysis/*.out.json
scripts/analysis/tmp*/
