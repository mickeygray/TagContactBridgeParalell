# RingCentral
RC_SERVER_URL=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT_TOKEN=
# RingCX Call Recording Delivery — once-per-hour inbox drain.
# Reads .wav files RingCX has pushed to a local SFTP inbox, parses
# each filename for the telephonySessionId, matches to CallLog,
# uploads to Drive, stamps CallLog, moves the source to /processed/.
# Defaults to project-relative ops/cx-recording-inbox/{inbox,processed,unknown}
# so Windows test runs work out of the box; override paths in prod.
CX_RECORDING_INBOX_DRAIN_ENABLED=false
CX_RECORDING_INBOX_DIR=
CX_RECORDING_INBOX_PROCESSED_DIR=
CX_RECORDING_INBOX_UNKNOWN_DIR=
CX_RECORDING_INBOX_MAX_PER_TICK=200
# Which Drive destination bucket to upload into. Matches the
# existing recordingArchive destinations (og / cs / as). Default
# `as` keeps CX-push recordings alongside the EX-side archives.
CX_RECORDING_INBOX_DRIVE_DEST_KEY=as

RC_OAUTH_AUTHORIZE_URL=https://platform.ringcentral.com/restapi/oauth/authorize
# Space-separated scope list sent on the RC authorize URL. Blank uses the
# code default which includes CXRouting (the scope that gates RingCX
# off-hook). Leaving this blank is OK in production; only override if
# your RC app config blocks one of the defaults (RC rejects the
# authorize URL on disallowed scopes rather than ignoring them).
# Default: "CXRouting ReadAccounts ReadCallLog ReadCallRecording ReadPresence"
RC_OAUTH_SCOPES=
RC_WEBHOOK_BASE_URL=
RC_WEBHOOK_SECRET=
RC_REFRESH_INTERVAL_MS=2700000
RC_AUTO_REINIT_BUSINESS_HOURS_ONLY=true
RC_AUTO_REINIT_TIMEZONE=America/Los_Angeles
RC_AUTO_REINIT_START_HOUR=7
RC_AUTO_REINIT_END_HOUR=18
RC_AUTO_REINIT_WEEKDAYS=1,2,3,4,5
RC_PRESENCE_STARTUP_SEED_ENABLED=true
RC_PRESENCE_POLL_BUSINESS_HOURS_ONLY=true
RC_PRESENCE_POLL_TIMEZONE=America/Los_Angeles
RC_PRESENCE_POLL_START_HOUR=7
RC_PRESENCE_POLL_END_HOUR=18
RC_PRESENCE_POLL_WEEKDAYS=1,2,3,4,5
RC_PRESENCE_POLL_INTERVAL_MS=30000
RC_PRESENCE_FULL_POLL_INTERVAL_MS=120000
RC_PRESENCE_STALE_THRESHOLD_MS=120000
RC_PRESENCE_POLL_MIN_TOKEN_TTL_MS=300000
RC_PRESENCE_POLL_PACE_MS=250

