# Optional RCX platform token cache minted from the *2 developer app.
# This is NOT the legacy digital API key and not yet a RingCX voice token
# exchange result; it is the platform bearer token minted from the app with
# CX-routing scopes. Refresh with `npm run rcx:refresh-platform-token`.
RCX_PLATFORM_ACCESS_TOKEN=
RCX_PLATFORM_REFRESH_TOKEN=
RCX_PLATFORM_TOKEN_TYPE=
RCX_PLATFORM_SCOPE=
RCX_PLATFORM_OWNER_ID=
RCX_PLATFORM_ENDPOINT_ID=
RCX_PLATFORM_EXPIRES_IN=
RCX_PLATFORM_EXPIRES_AT=

# RingCX voice routing for CX queue placement.
# `RINGCX_VOICE_NEW_CAMPAIGN_ID` defaults to `2306` in code when unset so
# fresh-day1/new tickets still carry the intended RCX destination.
RINGCX_VOICE_ACCOUNT_ID=
RINGCX_VOICE_DEFAULT_DIAL_GROUP_ID=
RINGCX_VOICE_DEFAULT_CAMPAIGN_ID=
RINGCX_VOICE_NEW_CAMPAIGN_ID=
RINGCX_VOICE_OLD_CAMPAIGN_ID=
RINGCX_VOICE_AGED_CAMPAIGN_ID=
# Optional agent-specific routing. Suffix is the assigned RingEX user/extension id
# or a sanitized username/name token. These routes win over family defaults.
RINGCX_AGENT_ROUTE_63756126004_DIAL_GROUP_ID=
RINGCX_AGENT_ROUTE_63756126004_CAMPAIGN_ID=
# ringcx-campaign-queue keeps the current queue/campaign behavior.
# manual uses createManualAgentCall directly and requires the agent to have a
# live RingCX voice session already established in the RC/CX agent app.
# manual-then-campaign tries manual first, then falls back to campaign queue
# for manual-session/device failures and unverified placements.
RINGCX_DIAL_EXECUTION_MODE=ringcx-campaign-queue
# RC support lists live agent/IQ session endpoints under /v1/admin, while
# campaign/lead/gate/active-call endpoints stay under /voice/api/v1/admin.
RINGCX_SESSION_ADMIN_PATH_PREFIX=/v1/admin
RINGCX_MANUAL_CALL_USE_USER_BEARER=true
RINGCX_MANUAL_CALL_PREFLIGHT_ENABLED=true
# Strict=false: missing/unavailable preflight endpoint warns but does not block.
# Explicit "not logged in/no off-hook session" still blocks manual calls.
RINGCX_MANUAL_CALL_PREFLIGHT_STRICT=false
RINGCX_MANUAL_CALL_RING_DURATION_SECONDS=8
CX_DIAL_FALLBACK_ON_UNVERIFIED=true
# Keep manual fallback quick. If manual placement is accepted but no active CX
# call appears within this window, manual-then-campaign rolls into campaign queue.
RCX_ACTIVE_CALL_VERIFY_MS=7000
# 0 keeps campaign queue dial requests fast; the async agent monitor can still
# reconcile active calls. Raise only if we need synchronous UII capture.
RINGCX_CAMPAIGN_CALL_CAPTURE_MS=0
RINGCX_CAMPAIGN_CALL_CAPTURE_INTERVAL_MS=500
RINGCX_PENDING_AGENT_ID_ON_LOAD_ENABLED=false
RINGCX_AGENT_RESERVATION_ENABLED=false
RINGCX_AGENT_RESERVATION_REQUIRED=false

# RingCentral / RingCX 429 circuit breakers.
# EX stays coarse because it is mostly metrics. CX is scoped by API family, so
# one hot lane (recordings, active calls, campaigns) does not freeze every CX call.
RC_RATE_LIMIT_BACKOFF_MS=300000
RC_AUTH_RATE_LIMIT_BACKOFF_MS=300000
RC_API_RATE_LIMIT_BACKOFF_MS=300000
RC_RATE_LIMIT_MAX_BACKOFF_MS=900000
RINGCX_RATE_LIMIT_BACKOFF_MS=300000
RINGCX_AUTH_RATE_LIMIT_BACKOFF_MS=300000
RINGCX_API_RATE_LIMIT_BACKOFF_MS=60000
RINGCX_RATE_LIMIT_MAX_BACKOFF_MS=900000
# Proactive CX throttle. These buffers run before RingCX returns 429.
RINGCX_PROACTIVE_THROTTLE_ENABLED=true
RINGCX_API_MIN_INTERVAL_MS=
RINGCX_ADMIN_READ_MIN_INTERVAL_MS=750
RINGCX_ADMIN_WRITE_MIN_INTERVAL_MS=1500
RINGCX_AGENT_READ_MIN_INTERVAL_MS=750
RINGCX_AGENT_WRITE_MIN_INTERVAL_MS=1500
RINGCX_ACTIVE_CALL_LIST_MIN_INTERVAL_MS=1000
RINGCX_ACTIVE_CALL_CONTROL_MIN_INTERVAL_MS=1250
RINGCX_MANUAL_OUTBOUND_MIN_INTERVAL_MS=1500
RINGCX_LEAD_ACTION_MIN_INTERVAL_MS=1500
RINGCX_CAMPAIGN_READ_MIN_INTERVAL_MS=750
RINGCX_CAMPAIGN_WRITE_MIN_INTERVAL_MS=1500
# RingCX docs put interaction metadata at 2 calls/min. Keep this above 30s.
RINGCX_RECORDING_METADATA_MIN_INTERVAL_MS=31000
RINGCX_RECORDING_DOWNLOAD_MIN_INTERVAL_MS=2500
RINGCENTRAL_RATE_LIMIT_ALERTS_ENABLED=true
RINGCENTRAL_RATE_LIMIT_ALERT_RECIPIENTS=mgray@taxadvocategroup.com
RINGCENTRAL_RATE_LIMIT_ALERT_COMPANY=TAG
RINGCENTRAL_RATE_LIMIT_ALERT_THROTTLE_MS=60000
# Optional JSON override. Placeholders: {agentId}, {agentUsername},
# {agentEmail}, {agentGroupId}, {rcUserId}, {extensionId}, {caseId}, {callbackDts}.
RINGCX_AGENT_RESERVATION_PARAM_MAP_JSON=
# AGENT_RESERVATION is an agent-specific callback action, not the live
# queue routing primitive. Leave disabled unless deliberately testing.
RINGCX_AGENT_RESERVATION_CALLBACK_DTS=
RINGCX_AGENT_RESERVATION_CALLBACK_DELAY_MS=0

# CX fresh hot lane: new leads are assigned immediately. Automatic
# release/reassignment is disabled while RingCX campaign copies are being
# hardened; agents keep the leads they are served until disposition/logout.
RC_CX_FRESH_HOT_LANE_ENABLED=true
RC_CX_FRESH_HOT_LANE_INTERVAL_MS=300000
RC_CX_FRESH_HOT_LANE_MORNING_HOUR=7
RC_CX_FRESH_HOT_LANE_MORNING_MINUTE=0
RC_CX_FRESH_HOT_LANE_BATCH_SIZE=50
RC_CX_FRESH_HOT_LANE_DOMAINS=WYNN,TAG
RC_CX_FRESH_HOT_LANE_ROLLOVER_HOUR=16
RC_CX_FRESH_HOT_LANE_IMMEDIATE_ENABLED=true
RC_CX_FRESH_HOT_LANE_IMMEDIATE_MAX=25
RC_CX_FRESH_CLAIM_MINUTES=480
RC_CX_FRESH_OPEN_ASSIGNMENTS=5
RC_CX_DAY2TO15_OPEN_ASSIGNMENTS=15
RC_CX_AGED_OPEN_ASSIGNMENTS=5
RC_CX_RELEASE_EXPIRED_ASSIGNMENTS_ENABLED=false
RC_CX_RELEASE_STALE_SERVING_ENABLED=false
RC_CX_FRESH_HOT_LANE_REBALANCE_ENABLED=false
RC_CX_EX_BUSY_GATE_ENABLED=false
RC_CX_MANUAL_UNAVAILABLE_RELEASE_ENABLED=false
RCX_STALE_DIAL_SWEEP_ENABLED=false
# Current production mode uses the platform RingCX/JWT dial path and
# identifies the logged-in human by extension/profile. Set true only
# when per-user RingCentral OAuth is ready to be required for agents.
RC_CX_REQUIRE_USER_OAUTH=false
RC_CX_REQUIRE_WORKSPACE_ACTIVE=true
RC_CX_WORKSPACE_ACTIVE_TTL_MINUTES=5
RC_CX_STALE_WORKSPACE_QUEUE_REAPER_ENABLED=false
RC_CX_FRESH_REFILL_COUNT=1
RC_CX_FRESH_REFILL_FAMILIES=fresh-day1
RC_CX_EMPTY_QUEUE_REFILL_ENABLED=true
RC_CX_EMPTY_QUEUE_REFILL_COUNT=20
RC_CX_EMPTY_QUEUE_REFILL_FAMILIES=fresh-day2to10,aged
RC_CX_NONFRESH_CLAIM_MINUTES=30
RC_CX_NONFRESH_OPEN_ASSIGNMENTS=20
# Internal service-to-service auth used for localhost relays like
# control-plane -> ringcentral-cx dispatch.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-string
# Detailed /health and /status payloads require this token when set.
# Set REQUIRE_HEALTH_TOKEN=true in strict deployments to fail startup if
# HEALTH_TOKEN is missing.
HEALTH_TOKEN=
REQUIRE_HEALTH_TOKEN=false
# Optional shared secret for /drop-webhook. Leave empty only for legacy
# private deployments that rely on network controls.
DROP_WEBHOOK_SECRET=
DROP_WEBHOOK_KEY=

# Sales-site deploy/blogger paths. Defaults assume sibling repos next
# to TagContactBridgeParallel; set these explicitly on Linux/containers.
