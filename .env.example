ADMIN_NAME=Parallel Admin
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_PREVIEW: when true, /auth/send-code returns the OTP code
# inline in the response body. ONLY set to true in dev. Strict-mode
# startup (NODE_ENV=production) refuses to boot if this is true.
AUTH_OTP_PREVIEW=true
# AUTH_OTP_FROM_EMAIL: required when AUTH_OTP_PREVIEW=false. Falls
# back to SENDGRID_FROM_EMAIL.
AUTH_OTP_FROM_EMAIL=
AUTH_OTP_FROM_NAME=TagContactBridge
AUTH_OTP_SUBJECT=Your sign-in code
AUTH_OTP_REQUEST_COOLDOWN_SECONDS=60

