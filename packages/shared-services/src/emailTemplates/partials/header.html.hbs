<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:{{brand.headerColor}};">
  <tr>
    <td style="padding:24px 32px;">
      <div style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:600;letter-spacing:0.2px;">{{brand.name}}</div>
      <div style="color:#cbd5e1;font-family:Helvetica,Arial,sans-serif;font-size:13px;margin-top:4px;">{{brand.tagline}}</div>
    </td>
  </tr>
  <tr>
    <td style="height:4px;background:{{brand.accentColor}};line-height:4px;font-size:0;">&nbsp;</td>
  </tr>
</table>
