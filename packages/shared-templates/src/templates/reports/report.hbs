<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} {{range}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 12px;">
      <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:760px;background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 1px 3px rgba(16,24,40,.1);">

          {{!-- No masthead. The subject line already carries the report name,
                the date range and the tenant; repeating them in a dark banner
                spent the top of the screen restating the envelope. --}}

          {{#each sections}}
            <tr><td style="padding:20px 24px 0;">
              <div style="font-size:13px;font-weight:600;color:#0f172a;border-bottom:2px solid #0f172a;padding-bottom:6px;">{{this.label}}</div>
            </td></tr>

            {{#if this.error}}
              <tr><td style="padding:10px 24px 4px;">
                <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:10px 12px;color:#991b1b;font-size:13px;">
                  unavailable — {{this.error}}
                </div>
              </td></tr>
            {{else}}
              {{#if this.summary}}
                <tr><td style="padding:10px 24px 0;">
                  <div style="font-size:15px;color:#0f172a;line-height:1.5;font-variant-numeric:tabular-nums;">{{this.summary}}</div>
                </td></tr>
              {{/if}}

              {{#if this.rows.length}}
                <tr><td style="padding:8px 24px 0;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12.5px;">
                    <tr>
                      {{#each this.columns}}
                        <th style="text-align:{{#if this.numeric}}right{{else}}left{{/if}};padding:6px 8px 6px 0;border-bottom:1px solid #e2e8f0;color:#64748b;font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;font-weight:600;white-space:nowrap;">{{this.label}}</th>
                      {{/each}}
                    </tr>
                    {{#each this.rows}}
                      <tr>
                        {{#each this}}
                          <td style="padding:5px 8px 5px 0;border-bottom:1px solid #f1f5f9;{{#if this.numeric}}text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;{{/if}}{{#if this.negative}}color:#b91c1c;{{/if}}{{#if this.muted}}color:#94a3b8;{{/if}}">
                            {{#if this.link}}<a href="{{this.link}}" style="color:#2563eb;">listen</a>{{else}}{{this.text}}{{/if}}
                          </td>
                        {{/each}}
                      </tr>
                    {{/each}}
                  </table>
                </td></tr>
              {{else}}
                {{!-- A summary already said what happened; "Nothing in this
                      range" underneath it would contradict the line above. --}}
                {{#unless this.summary}}
                  <tr><td style="padding:8px 24px 0;">
                    <div style="color:#94a3b8;font-size:13px;">Nothing in this range.</div>
                  </td></tr>
                {{/unless}}
              {{/if}}
            {{/if}}

            {{!-- Terms are no longer printed under every section. They still
                  travel on the report object and into the CSV/text renderings,
                  where someone auditing a number can find them — but a
                  paragraph of definition under each table, every night, is
                  read once and skipped forever. --}}
          {{/each}}

          {{!-- No "Worth knowing" block. Gather notes are operator telemetry —
                snapshot coverage, feed syncs, catch-all counts. They still
                travel on the report object and print in the CLI and the text
                rendering, which is where someone debugging a number looks. In
                the mail they were five lines of caveat under the answer. --}}
          {{!-- No footer. "Gathered live from the source systems" is a claim
                about the plumbing, not information anyone acts on. --}}
          <tr><td style="padding:0 0 22px;"></td></tr>

        </table>
      </td></tr>
    </table>
  </body>
</html>
