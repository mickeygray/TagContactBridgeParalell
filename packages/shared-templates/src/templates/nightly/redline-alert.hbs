<!DOCTYPE html>
<html><head><meta charset="utf-8">{{> base-css}}</head>
<body>
  <div class="wrap">
    {{> header}}
    {{> alert-banner}}

    <div class="section">
      <h2>Failed payments — {{date}}</h2>
      <table class="data" cellpadding="0" cellspacing="0">
        <tr>
          <th>Client</th>
          <th class="center">Case</th>
          <th class="center">Amount</th>
          <th class="center">Attempts</th>
          <th class="center">Status</th>
          <th>Comment</th>
        </tr>
        {{#each alerts}}
        <tr>
          <td>
            <div><strong>{{default name "Unknown"}}</strong></div>
            <div class="mono">{{default phoneFormatted phone}}</div>
          </td>
          <td class="center">{{domain}} #{{caseId}}</td>
          <td class="center"><strong class="score-red">{{money declinedAmount}}</strong></td>
          <td class="center">{{attempts}}</td>
          <td class="center"><span class="pill redline">{{lastTransactionStatus}}</span></td>
          <td>{{default lastTransactionComment ""}}</td>
        </tr>
        {{/each}}
      </table>
    </div>

    <div class="section">
      <div class="summary-line">Full list attached as <strong>{{csvFilename}}</strong>.</div>
    </div>

    {{> footer}}
  </div>
</body></html>
