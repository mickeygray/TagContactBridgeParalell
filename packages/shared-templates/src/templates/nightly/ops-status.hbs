<!DOCTYPE html>
<html><head><meta charset="utf-8">{{> base-css}}</head>
<body>
  <div class="wrap">
    {{> header}}

    <div class="section">
      <h2>App status — {{date}}</h2>
      {{> kpi-tiles tiles=topTiles}}
    </div>

    <div class="section">
      <h2>Final reconcile</h2>
      <table class="data" cellpadding="0" cellspacing="0">
        <tr>
          <th>Step</th>
          <th class="center">Status</th>
          <th>Detail</th>
        </tr>
        <tr>
          <td>Spend sync</td>
          <td class="center">
            {{#if spendSync.ok}}
              <span class="pill client">ok</span>
            {{else}}
              {{#if spendSync.skipped}}
                <span class="pill unknown">skipped</span>
              {{else}}
                <span class="pill dnc">error</span>
              {{/if}}
            {{/if}}
          </td>
          <td>{{default spendSync.error spendSync.reason}}</td>
        </tr>
        <tr>
          <td>Payment reconcile</td>
          <td class="center"><span class="pill client">ok</span></td>
          <td>{{paymentSweep.casesScanned}} cases scanned · {{paymentSweep.newLedgerRows}} new ledger rows · {{paymentSweep.flaggedFailures}} flagged failures</td>
        </tr>
        <tr>
          <td>Lead cadence case refresh</td>
          <td class="center">
            {{#if leadCadenceCaseRefresh.skipped}}
              <span class="pill unknown">skipped</span>
            {{else}}
              <span class="pill client">ok</span>
            {{/if}}
          </td>
          <td>{{leadCadenceCaseRefresh.totals.casesScanned}} cases refreshed Â· {{leadCadenceCaseRefresh.totals.statusChanges}} status changes Â· {{leadCadenceCaseRefresh.totals.errors}} errors</td>
        </tr>
      </table>
    </div>

    <div class="section">
      <h2>Hourly job queue</h2>
      <div>
        Pruned resolved: <strong>{{bugWrap.prunedResolved}}</strong>
        &nbsp;·&nbsp; Still unresolved: <strong>{{bugWrap.unresolvedCount}}</strong>
      </div>
      {{#if hourlyBugs.length}}
        <table class="data" cellpadding="0" cellspacing="0" style="margin-top:8px;">
          <tr>
            <th>Handler</th>
            <th>Event</th>
            <th class="center">Status</th>
            <th>Last error</th>
          </tr>
          {{#each hourlyBugs}}
          <tr>
            <td>{{handlerKey}}</td>
            <td>{{eventType}}</td>
            <td class="center"><span class="pill {{statusPillClass status}}">{{status}}</span></td>
            <td><span class="muted">{{default lastError firstError}}</span></td>
          </tr>
          {{/each}}
        </table>
      {{else}}
        <div class="muted">No unresolved hourly jobs.</div>
      {{/if}}
    </div>

    <div class="section">
      <h2>Attribution review queue</h2>
      <div>
        Held out: <strong>{{default attributionReview.skipped 0}}</strong>
        &nbsp;·&nbsp; Newly queued: <strong>{{default attributionReview.queued 0}}</strong>
        &nbsp;·&nbsp; Resolved tonight: <strong>{{default attributionReview.resolved 0}}</strong>
        &nbsp;·&nbsp; Ignored: <strong>{{default attributionReview.ignored 0}}</strong>
      </div>
      <div class="summary-line">Unresolved rows are excluded from the lead-data email's topline numbers. Walk the Review workspace to fold them into tomorrow.</div>
    </div>

    {{#if openServiceAlerts.length}}
    <div class="section">
      <h2>Open service alerts</h2>
      <table class="data" cellpadding="0" cellspacing="0">
        <tr>
          <th>When</th>
          <th>Severity</th>
          <th>Title</th>
          <th>Summary</th>
        </tr>
        {{#each openServiceAlerts}}
        <tr>
          <td>{{formatDate happenedAt}}</td>
          <td><span class="pill {{statusPillClass severity}}">{{severity}}</span></td>
          <td>{{title}}</td>
          <td><span class="muted">{{summary}}</span></td>
        </tr>
        {{/each}}
      </table>
    </div>
    {{/if}}

    {{#if leadIntake.total}}
    <div class="section">
      <h2>Quick lead intake reference</h2>
      <table class="data" cellpadding="0" cellspacing="0">
        <tr>
          <th>Source</th>
          <th class="center">Today</th>
        </tr>
        {{#each leadIntake.entries}}
        <tr>
          <td>{{source}}</td>
          <td class="center">{{count}}</td>
        </tr>
        {{/each}}
      </table>
    </div>
    {{/if}}

    {{#if notes.length}}
    <div class="section">
      <h2>Things to look at</h2>
      <ul>
        {{#each notes}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{> footer}}
  </div>
</body></html>
